# Default-deny: only the files and directories documented in README's
# "Project Layout" are eligible to be tracked.
/*

# Keep repository documentation and this rule file.
!/.gitignore
!/README.md

# Figures referenced by README.md.
!/imgs/
!/imgs/*.png

# Top-level project files from the layout.
!/batch_restore_and_snapshot.py
!/run_memubench.py

# Project directories from the layout.
!/move_data/
!/move_data/**
!/apks/
!/apks/**
/user_database/
  /user_history/
!/memory_generation/
!/memory_generation/**
/memory_generation/memory/ablation.py
!/retrieve_information/
!/retrieve_information/**
/retrieve_information/embedding.py
/retrieve_information/memory_raw.py
/retrieve_information/rag_retrieve.py
/retrieve_information/summary_embedding.py
/retrieve_information/summary_rag_retrieve.py
/retrieve_information/w_o_ai.py
/retrieve_information/w_o_if.py
/retrieve_information/w_o_sv.py
!/eval/
/eval/*
!/eval/eval_checkpoint.py
!/eval/eval_metrics.py
!/eval_results/
/eval_results/*
!/eval_results/human.json
# Local evaluation outputs. Not distributed: generated by eval/eval_metrics.py.
/metric_results/
!/android_world/
!/android_world/**
/android_world/tmp/
/android_world/apps/
/android_world/apps.zip

# Never commit credentials or environment configuration files.
*.env
.env

# Python and macOS-generated files within the allowed directories.
*.py[cod]
__pycache__/
.DS_Store

# Project page (GitHub Pages) and its deploy workflow.
!/pages/
!/pages/**
!/.github/
!/.github/**

# README hero and title images.
!/assets/
!/assets/**
